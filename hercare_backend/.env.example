NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=hercare_db
DB_USER=hercare_user
DB_PASSWORD=replace-with-a-strong-password
DB_SSL=false

JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=replace-with-a-different-32-byte-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# 32 random bytes encoded as base64, used for private journal encryption and
# blind search indexes. Generate once and keep stable across deployments.
JOURNAL_ENCRYPTION_KEY=

# Separate 32-byte base64 (or 64-character hex) key for M7 chat encryption.
# If omitted outside production, JOURNAL_ENCRYPTION_KEY is used as a fallback.
CHAT_ENCRYPTION_KEY=

# Firebase Cloud Messaging. The Spark plan is sufficient for FCM delivery.
# Keep service-account JSON only in deployment secrets, never in source control.
FIREBASE_PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Separate 32-byte base64 (or 64-character hex) key for FCM registration tokens.
PUSH_TOKEN_ENCRYPTION_KEY=

# Private voice-journal object storage. Works with AWS S3 or a compatible
# service. Use workload credentials in production; do not commit access keys.
AWS_REGION=ap-south-1
JOURNAL_AUDIO_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# Private Python M4 service. Use the same strong random token in both services.
ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_TOKEN=

LOG_LEVEL=info
