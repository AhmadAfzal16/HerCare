NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=hercare_db
DB_USER=hercare_user
DB_PASSWORD=replace-with-a-strong-password
DB_SSL=false

JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=replace-with-a-different-32-byte-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# 32 random bytes encoded as base64, used for private journal encryption and
# blind search indexes. Generate once and keep stable across deployments.
JOURNAL_ENCRYPTION_KEY=

# Separate 32-byte base64 (or 64-character hex) key for M7 chat encryption.
# If omitted outside production, JOURNAL_ENCRYPTION_KEY is used as a fallback.
CHAT_ENCRYPTION_KEY=

# Firebase Cloud Messaging. The Spark plan is sufficient for FCM delivery.
# Keep service-account JSON only in deployment secrets, never in source control.
FIREBASE_PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Separate 32-byte base64 (or 64-character hex) key for FCM registration tokens.
PUSH_TOKEN_ENCRYPTION_KEY=

# Basic voice notes are encrypted with JOURNAL_ENCRYPTION_KEY and stored in
# PostgreSQL after migration 013. The following settings are only for the
# legacy signed-object upload and optional speech-to-text workflow.
AWS_REGION=ap-south-1
JOURNAL_AUDIO_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# Private Python M4 service. Use the same strong random token in both services.
ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_TOKEN=

# M12 private, owned AI service. No hosted AI provider/API key is needed.
# Use private HTTPS for a production non-local service.
COMMUNITY_MODERATION_URL=http://127.0.0.1:8001/v1/community/moderate
# Production requires AI before publication by default. Human approval is always
# mandatory; explicit false is a documented human-only degraded mode.
COMMUNITY_AI_REQUIRED=true

# M11 links must be HTTPS on these exact, operator-reviewed publisher hosts.
# No requests to arbitrary media URLs are made by the recommendation API.
CONTENT_MEDIA_ALLOWED_HOSTS=api.alquran.cloud,alquran.cloud,cdn.islamic.network,commons.wikimedia.org,upload.wikimedia.org,www.nimh.nih.gov,www.nhs.uk,www.who.int,www.youtube.com,youtu.be

# Self-hosted sentiment only; rules remain the safety fallback, not a clinical model.
NLP_ENABLED=true
# Do not enable gathering/export until an approved prospective study exists.
RESEARCH_COLLECTION_ENABLED=false
RESEARCH_STUDY_ID=
RESEARCH_EXPORT_ENABLED=false
# At least 32 random characters, separate from JWT/encryption keys.
RESEARCH_PSEUDONYM_KEY=

LOG_LEVEL=info

# M6 private Hum-Raaz. Not an external AI-provider API key.
# Stable 32-byte base64/64-character hex key, or existing CHAT/JOURNAL key fallback.
CHATBOT_ENCRYPTION_KEY=
CHATBOT_TIMEOUT_MS=35000
# Non-loopback ML service connections require HTTPS; allow only own private DNS.
ML_SERVICE_HOST_ALLOWLIST=
# Urgent guardian sharing uses M10's separate, default-off current-link safety
# confirmation. General Tier2 sharing never enables crisis disclosures by itself.

# M10 optional separate AES-GCM key (32-byte base64 or 64-character hex).
# Blank reuses stable JOURNAL_ENCRYPTION_KEY; production must configure a strong key.
# Do not rotate without re-encrypting existing safety plans. No external AI key needed.
CRISIS_ENCRYPTION_KEY=
# M5 private ASR: same owned ML service, no Google Speech/API billing.
# Run migration020 and provision the separate public voice weights first.
# No existing voice note is automatically enrolled; mothers request transcripts.
VOICE_WORKER_ENABLED=true
